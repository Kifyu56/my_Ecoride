# Éviter les fichiers de logs
*.log
error_log
debug.log

# Exclure les fichiers de configuration sensibles
.env
config.php

# Ignorer les fichiers de cache et sessions
cache/
sessions/

# Ignorer les dépendances (si tu utilises Composer)
vendor/
composer.lock

# Ignorer les fichiers de base de données temporaires
*.sql~
*.sqlite

# Ignorer les fichiers IDE & éditeurs
.vscode/
.idea/
*.swp
*.swo
*.bak

# Exclure les fichiers générés
node_modules/
.DS_Store
Thumbs.db

.txt
