<?php
/**
 * Script pour générer des mots de passe hachés avec password_hash()
*/

$users = [
    ['id' => 1, 'username' => 'admin_jose', 'password' => 'adminpassword'],
    ['id' => 2, 'username' => 'employee_alain', 'password' => 'employeepassword'],
    ['id' => 3, 'username' => 'jdupont', 'password' => 'pass1234'],
    ['id' => 4, 'username' => 'mcurie', 'password' => 'scientific123']
];

foreach ($users as $user) {
    $hashedPassword = password_hash($user['password'], PASSWORD_BCRYPT);
    echo "INSERT INTO Authentication (user_id, username, password_hash) VALUES ({$user['id']}, '{$user['username']}', '{$hashedPassword}');\n";
}

?>
